{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pixel-asset-forge/pixel-asset-forge/schemas/asset-pack.schema.json",
  "title": "Pixel Asset Forge — Asset Pack",
  "description": "共享风格、背景、导出设置、显式色板与可选动作集的一组资产。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_type",
    "pack_id",
    "shared",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pack_type": {
      "enum": ["potion_pack", "weapon_pack", "environment_pack", "spell_bundle", "combat_bundle"]
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "background",
        "export",
        "palette"
      ],
      "properties": {
        "style": {
          "$ref": "#/$defs/style"
        },
        "background": {
          "$ref": "#/$defs/background"
        },
        "export": {
          "$ref": "#/$defs/export"
        },
        "palette": {
          "$ref": "#/$defs/palette"
        },
        "animations": {
          "description": "整包共享的动作列表。动画 bundle 必填，静态 pack 必须省略。",
          "type": "array",
          "minItems": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "description"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pack_type": {
            "enum": ["spell_bundle", "combat_bundle"]
          }
        },
        "required": ["pack_type"]
      },
      "then": {
        "properties": {
          "shared": {
            "required": ["animations"]
          }
        }
      },
      "else": {
        "properties": {
          "shared": {
            "not": {
              "required": ["animations"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pack_type": {
            "const": "combat_bundle"
          }
        },
        "required": ["pack_type"]
      },
      "then": {
        "properties": {
          "shared": {
            "properties": {
              "animations": {
                "items": {
                  "$ref": "#/$defs/combat_animation"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "shared": {
            "properties": {
              "animations": {
                "items": {
                  "$ref": "#/$defs/animation"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hex_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "logical_size": {
      "enum": [16, 24, 32, 48, 64, 96, 128]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perspective",
        "target_size",
        "max_colors"
      ],
      "properties": {
        "perspective": {
          "enum": ["top_down_3_4", "top_down", "side_view", "isometric"]
        },
        "target_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/logical_size"
          }
        },
        "max_colors": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "outline": {
          "enum": ["none", "single_pixel_dark", "single_pixel_colored"],
          "default": "single_pixel_dark"
        },
        "shading": {
          "enum": ["flat", "two_tone", "three_tone"],
          "default": "two_tone"
        },
        "antialiasing": {
          "type": "boolean",
          "default": false
        },
        "lighting": {
          "enum": ["fixed_top_left", "fixed_top", "fixed_top_right", "none"],
          "default": "fixed_top_left"
        },
        "strict_lighting": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["chroma_key", "transparent_model", "rembg"],
          "default": "chroma_key"
        },
        "color": {
          "$ref": "#/$defs/hex_color",
          "default": "#FF00FF"
        },
        "fallback_colors": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/hex_color"
          },
          "default": ["#00FF00", "#00FFFF"]
        },
        "conflict_hint": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["generic-json", "godot", "phaser", "tiled"]
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hex_color"
          }
        }
      }
    },
    "animation_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["down", "left", "right", "up"]
          }
        },
        "frames": {
          "enum": [4, 6, 8, 9, 12]
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "beats": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "description": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "cycle": {
          "type": "string",
          "enum": ["one_shot", "loop", "gait"]
        }
      }
    },
    "animation": {
      "$ref": "#/$defs/animation_fields",
      "required": ["name", "frames", "fps"]
    },
    "combat_animation": {
      "$ref": "#/$defs/animation_fields",
      "description": "combat_bundle 动作；frames/fps/loop 缺省时走 ACTION_DEFAULTS。",
      "required": ["name"]
    }
  }
}
